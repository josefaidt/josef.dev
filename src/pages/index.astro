---
import { Icon } from "astro-icon/components"
import BaseHead from "../components/BaseHead.astro"
import CurrentlyPlaying from "../components/CurrentlyPlaying.astro"
import { SITE_DESCRIPTION, SITE_OWNER_SOCIALS } from "../constants"
---

<BaseHead title="josef.dev" description={SITE_DESCRIPTION} />
<div class="flex flex-col min-h-screen">
  <div class="flex items-center justify-center flex-1">
    <div class="relative">
      <!--
        Each link is padded into a 26x34px tap target, larger than the 18px icon, and the targets
        meet edge to edge, which leaves the icons 8px apart. The negative margin cancels the outer
        padding so the icons keep their place above the logo.
      -->
      <nav class="top-1.5 right-13 -mx-1 -my-2 w-fit absolute z-20 flex items-center">
        {
          SITE_OWNER_SOCIALS.map((social) => (
            <a
              class="flex items-center px-1 py-2"
              href={social.url}
              rel="noopener noreferrer"
              target="_blank"
              aria-label={`Visit ${social.name}`}
            >
              <Icon name={`simple-icons:${social.name.toLowerCase()}`} size={18} />
            </a>
          ))
        }
      </nav>
      <div id="logo" class="relative">
        <h1 class="text-9xl select-none" data-layer="1">josef</h1>
        <span
          class="text-9xl font-medium absolute top-0.5 left-1.5 -z-10 blur-[0.2px] select-none"
          data-layer="2"
        >
          josef
        </span>
        <span
          class="text-9xl font-medium absolute top-1 left-3 -z-20 blur-[0.4px] select-none"
          data-layer="3"
        >
          josef
        </span>
        <span
          class="text-9xl font-medium absolute top-1.5 left-4.5 -z-30 blur-[0.6px] select-none"
          data-layer="4"
        >
          josef
        </span>
      </div>
      <CurrentlyPlaying />
    </div>
  </div>
</div>

<style>
  h1 {
    color: var(--color-primary);
    font-family: Josefin Sans;
  }

  [data-icon] {
    color: var(--josef-text-color-muted);
  }

  nav a:hover [data-icon],
  nav a:focus-visible [data-icon] {
    color: var(--josef-primary-color);
  }

  #logo {
    letter-spacing: 0.1rem;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
  }

  #logo > span {
    font-family: Josefin Sans;
    transform-style: preserve-3d;
    text-rendering: optimizeLegibility;
    color: var(--josef-text-color);
  }

  /* Dark theme colors (default) */
  #logo span[data-layer="2"] {
    color: var(--color-orange);
  }
  #logo span[data-layer="3"] {
    color: var(--color-accent);
  }
  #logo span[data-layer="4"] {
    color: var(--color-rouge-800);
  }

  /* Light theme - same four colors as the dark logo, reordered: the cream layer sits
     right behind the dark face as an outline, then orange and rose stripes */
  @media (prefers-color-scheme: light) {
    #logo [data-layer="1"] {
      color: var(--color-rouge-800);
    }
    #logo span[data-layer="2"] {
      color: var(--color-cream);
    }
    #logo span[data-layer="3"] {
      color: var(--color-orange);
    }
    #logo span[data-layer="4"] {
      color: var(--color-accent);
    }
  }

</style>
