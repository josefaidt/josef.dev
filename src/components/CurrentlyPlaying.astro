---
import type { Track } from "@spotify/web-api-ts-sdk"
import { Icon } from "astro-icon/components"
import { fetchSpotifyCurrentlyPlaying } from "../lib/spotify"

const currentlyPlaying = await fetchSpotifyCurrentlyPlaying()

let track: { url: string; text: string } | null = null

if (currentlyPlaying?.item?.type === "track") {
  const item = currentlyPlaying.item as Track
  track = {
    url: item.external_urls.spotify,
    text: `${item.name} – ${item.artists.map((artist) => artist.name).join(", ")}`,
  }
}

/**
 * The ticker measures its own overflow in CSS, but CSS cannot turn that distance into a duration,
 * so estimate it from the length: about 7px a character at text-sm, scrolled at about 30px a second
 * for the middle 60% of each pass.
 */
const overflow = Math.max(0, (track?.text.length ?? 0) * 7 - 212)
const duration = `${Math.max(4, overflow / 30 / 0.6).toFixed(1)}s`
---

<div id="currently-playing" class="right-0 -bottom-1.5 absolute">
  {
    track !== null ? (
      <a
        class="flex items-center justify-end gap-2"
        href={track.url}
        target="_blank"
        rel="noopener noreferrer"
        title={track.text}
      >
        <Icon
          name="simple-icons:spotify"
          size={16}
          aria-hidden="true"
        />
        <span class="ticker" style={`--ticker-duration: ${duration}`}>
          <span>{track.text}</span>
        </span>
      </a>
    ) : (
      <div class="flex items-center justify-end gap-2">
        <Icon
          name="simple-icons:spotify"
          size={16}
          aria-hidden="true"
        />
        <span class="ticker">
          <span>not currently playing...</span>
        </span>
      </div>
    )
  }
</div>

<style>
  #currently-playing a {
    text-decoration: none;
  }

  #currently-playing [data-icon] {
    flex-shrink: 0;
    color: var(--josef-text-color-muted);
  }

  /*
    The clipping box. It is a size container, so the text inside can read the box's width as
    100cqw and scroll by exactly the distance it overflows, which is zero for text that fits.
    It starts one fade-width early, over the gap after the icon, and the text is padded by the
    same amount, so text at rest sits where it would without the fade.
  */
  .ticker {
    --fade: 0.5rem;
    display: block;
    width: calc(212px + var(--fade));
    margin-left: calc(-1 * var(--fade));
    overflow: hidden;
    container-type: inline-size;
    white-space: nowrap;
    font-size: var(--text-sm);
    line-height: 1.5rem;
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 var(--fade),
      #000 calc(100% - var(--fade)),
      transparent
    );
  }

  .ticker > span {
    display: inline-block;
    padding-inline: var(--fade);
    color: var(--josef-text-color-muted);
    text-decoration: underline 2px transparent;
    transition: text-decoration-color 150ms ease;
    animation: ticker var(--ticker-duration, 4s) ease-in-out infinite alternate;
  }

  #currently-playing a:hover .ticker > span {
    text-decoration-color: var(--josef-primary-color);
  }

  /* Holds at each end, then eases back the way it came instead of snapping to the start */
  @keyframes ticker {
    0%,
    20% {
      translate: 0;
    }
    80%,
    100% {
      translate: min(0px, calc(100cqw - 100%));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker {
      text-overflow: ellipsis;
      mask-image: none;
    }

    .ticker > span {
      display: inline;
      animation: none;
    }
  }
</style>
